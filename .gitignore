# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.vercel
data/*.csv

# Large local datasets (never commit raw source dumps)
/data/**/*.csv
/data_reduced/**/*.csv
/backend/**/*.db
/backend/**/*.sqlite
/backend/**/*.sqlite3

# SQLite-Dumps nie ins Repo (Download zur Laufzeit).
/warehouse.db
/data/*.db

# Grosse Modell-Quellen / Backups bleiben lokal.
/data/warehouse.scene.unity
/data/warehouse.model.fbx
/data/*.original.glb

# Grosse 3D-/Unity-Assets bleiben lokal (nicht ins Repo, ~164 MB).
# Werden lokal gebundlet (siehe pubspec.yaml); frische Clones muessen sie separat beziehen.
/assets/models/
/assets/unity_source/

# Local generated exports / temp files
*.tmp
*.temp
*.bak
*.orig

# Python local caches (for data scripts)
__pycache__/
*.pyo
*.pyd
.venv/
venv/

# VS Code local workspace files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
# Local vendored Python deps for backend runtime
backend/_pydeps/
