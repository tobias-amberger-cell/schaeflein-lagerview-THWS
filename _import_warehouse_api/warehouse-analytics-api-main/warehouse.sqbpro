name="SQL 1*">WITH sales AS (

    SELECT 

        ARTIKELNR,

        SUM(MENGE_SOLL) AS total_qty

    FROM df_fahrpos_6mon_ber03_schlg_rti3

    GROUP BY ARTIKELNR

),

sorted AS (

    SELECT 

        ARTIKELNR,

        total_qty,

        SUM(total_qty) OVER (ORDER BY total_qty DESC) AS cumulative_qty,

        SUM(total_qty) OVER () AS total_sum

    FROM sales

)

SELECT 

    ARTIKELNR,

    total_qty,

    cumulative_qty * 1.0 / total_sum AS cumulative_share,

    CASE 

        WHEN cumulative_qty * 1.0 / total_sum &lt;= 0.8 THEN 'A'

        WHEN cumulative_qty * 1.0 / total_sum &lt;= 0.95 THEN 'B'

        ELSE 'C'

    END AS abc_class

FROM sorted

ORDER BY total_qty DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
